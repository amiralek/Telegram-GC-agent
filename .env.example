# Obtain personal Telegram app credentials at https://my.telegram.org/apps
TELEGRAM_API_ID=your_numeric_api_id
TELEGRAM_API_HASH=your_api_hash
# Phone, login code and 2FA password are prompted locally with hidden input.
# Raw authentication, retrieval, exports and MCP do not need OpenAI settings.
# OPTIONAL: install requirements-ai.txt and uncomment only for AI summaries.
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4.1-mini
# TELEGRAM_INTEL_ALLOW_LLM=true
TELEGRAM_INTEL_TIMEZONE=UTC
# Configure saves credentials in private app data by default.
# Default session/cache: %LOCALAPPDATA%\TelegramIntelligence (outside OneDrive)
# TELEGRAM_INTEL_DATA_DIR=C:\Users\YOUR_NAME\AppData\Local\TelegramIntelligence
TELEGRAM_INTEL_CACHE_TTL_SECONDS=300
TELEGRAM_INTEL_MAX_FLOOD_WAIT=300
# TELEGRAM_INTEL_BATCH_TOKENS=6000
# Optional: trusted contributors influence ranking, never factual confidence.
# TELEGRAM_INTEL_EXPERT_IDS=123456789,987654321
